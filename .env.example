# Copy to .env (never commit .env)
LLM_PROVIDER=groq            # groq | gemini | anthropic | openai | ollama
LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# LLM_MIN_INTERVAL=2         # seconds between LLM calls (free-tier rate limits)
